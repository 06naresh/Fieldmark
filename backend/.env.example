# Application Configuration
APP_ENV=development
APP_NAME=Fieldmark
SECRET_KEY=YOUR_DEVELOPMENT_JWT_SECRET_KEY_MIN_32_CHARS_LONG
API_PREFIX=/api/v1
LOG_LEVEL=INFO
MAX_PAGE_SIZE=100
SYNC_MAX_BATCH_SIZE=100
SYNC_MAX_PULL_LIMIT=100

# Database Connection (PostgreSQL / Neon)
# Format: postgresql+psycopg://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>
DATABASE_URL=postgresql+psycopg://<db_user>:<db_password>@localhost:5432/field_inspection_db
# Separate database used by automated tests. Never point this at production.
TEST_DATABASE_URL=postgresql+psycopg://<db_user>:<db_password>@localhost:5432/field_inspection_test_db
# Serverless-safe connection pool bounds per function instance.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OFFLINE_SESSION_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
JWT_ISSUER=fieldmark-api
JWT_AUDIENCE=fieldmark-client

# Refresh Cookie and CSRF
REFRESH_COOKIE_NAME=fieldmark_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
# Set to true in production over HTTPS.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=fieldmark_csrf
CSRF_COOKIE_PATH=/
# Set to true in production over HTTPS.
CSRF_COOKIE_SECURE=false
CSRF_HEADER_NAME=X-CSRF-Token

# Login Rate Limiting
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_KEYS=10000

# CORS Allowed Origins (Comma-separated)
FRONTEND_ORIGINS=http://localhost:5173
# Vercel injects VERCEL_URL automatically. Set PUBLIC_APP_URL when a custom domain is used.
# Production origins must be HTTPS; localhost origins are ignored in production.
VERCEL_URL=
PUBLIC_APP_URL=
